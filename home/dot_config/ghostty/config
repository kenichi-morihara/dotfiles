# Managed by chezmoi. Reload with Command+Shift+,.
font-family = HackGen Console NF
font-size = 12
theme = Dracula

# Command+Space: show/hide the same quick terminal from any application.
# macOS requires Accessibility permission for global shortcuts.
keybind = global:cmd+space=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-size = 60%
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.1
quick-terminal-space-behavior = move
