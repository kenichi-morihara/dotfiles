# Classification only; package declarations and options live in .Brewfile.
# Read brew bundle dump's one-declaration-per-line format without duplicating it.
core_formulae = %w[chezmoi fzf ghq mise ranger starship zinit]
source = File.join(__dir__, ".Brewfile")
found = []
File.foreach(source).with_index(1) do |entry, line|
  name = entry[/\Abrew "([^"]+)"/, 1]
  next unless core_formulae.include?(name)

  instance_eval(entry, source, line)
  found << name
end
missing = core_formulae - found
raise "Core packages missing from .Brewfile: #{missing.join(', ')}" unless missing.empty?
