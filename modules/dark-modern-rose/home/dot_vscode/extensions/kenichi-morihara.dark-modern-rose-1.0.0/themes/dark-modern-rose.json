{
  "$schema": "vscode://schemas/color-theme",
  "name": "Dark Modern Rose",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#E3E1ED",
    "editor.background": "#212127",
    "editor.foreground": "#E3E1ED",
    "editorLineNumber.foreground": "#9190A4",
    "editorLineNumber.activeForeground": "#E3E1ED",
    "editorBracketHighlight.foreground1": "#F1FA8C",
    "editorBracketHighlight.foreground2": "#DC92B7",
    "editorBracketHighlight.foreground3": "#74C4FF",
    "editorBracketHighlight.foreground4": "#62E1C7",
    "editorBracketHighlight.foreground5": "#BD93F9",
    "editorBracketHighlight.foreground6": "#FFAE92",
    "editor.lineHighlightBackground": "#FFFFFF08",
    "editor.selectionBackground": "#44475A",
    "editorGroupHeader.tabsBackground": "#292933",
    "activityBar.background": "#292933",
    "sideBar.background": "#292933",
    "titleBar.activeBackground": "#292933",
    "titleBar.inactiveBackground": "#292933",
    "statusBar.background": "#292933",
    "statusBar.noFolderBackground": "#292933",
    "panel.background": "#212127",
    "tab.activeBackground": "#212127",
    "tab.inactiveBackground": "#292933",
    "tab.activeBorderTop": "#BD93F9",
    "focusBorder": "#BD93F9",
    "widget.border": "#393947"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8DBB7A" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#FFAE92" } },
    { "scope": ["keyword", "storage", "variable.language"], "settings": { "foreground": "#BD93F9" } },
    { "name": "Control keywords are pink, as keyword.control is in VS Code Dark Modern (if/else/return/import; Ruby flags `else if` as invalid.deprecated)", "scope": ["keyword.control", "invalid.deprecated.ruby"], "settings": { "foreground": "#F78FD9" } },
    { "name": "Ruby block structure (def/class/module/do/end) stays purple so pink marks only branches and exits", "scope": ["keyword.control.def.ruby", "keyword.control.class.ruby", "keyword.control.module.ruby", "keyword.control.start-block.ruby", "keyword.control.end.ruby"], "settings": { "foreground": "#BD93F9" } },
    { "name": "Ruby and/or/not are operators (keyword.operator.logical in the built-in grammar)", "scope": ["keyword.control.logical.ruby"], "settings": { "foreground": "#BD93F9" } },
    { "scope": "keyword.operator", "settings": { "foreground": "#E3E1ED" } },
    { "scope": ["support.function.rails.dsl.ruby", "keyword.other.special-method"], "settings": { "foreground": "#DC92B7" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.class", "support.type"], "settings": { "foreground": "#62E1C7" } },
    { "scope": ["variable.other.constant", "variable.other.enummember", "constant.other"], "settings": { "foreground": "#74C4FF" } },
    { "scope": ["constant.language.symbol", "constant.other.symbol"], "settings": { "foreground": "#A6B4EE" } },
    { "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F0A04B" } },
    { "scope": ["entity.name.function", "support.function", "keyword.other.special-method.ruby"], "settings": { "foreground": "#F1E4A6" } },
    { "scope": ["variable", "variable.parameter"], "settings": { "foreground": "#74C4FF" } },
    { "scope": ["meta.embedded.line.ruby", "source.ruby.embedded.erb"], "settings": { "foreground": "#E3E1ED" } },
    { "scope": ["meta.embedded.line.ruby punctuation.section.embedded", "punctuation.section.embedded.begin.erb", "punctuation.section.embedded.end.erb"], "settings": { "foreground": "#BD93F9" } },
    { "scope": "entity.name.tag", "settings": { "foreground": "#DC92B7" } },
    { "scope": "entity.other.attribute-name", "settings": { "foreground": "#A6B4EE" } },
    { "scope": "punctuation.section.array", "settings": { "foreground": "#F1FA8C" } },
    { "name": "JS/TS word operators read like keywords (typeof, new, instanceof, in, keyof, is)", "scope": ["keyword.operator.expression", "keyword.operator.new", "keyword.operator.delete"], "settings": { "foreground": "#BD93F9" } },
    { "name": "JS/TS template interpolation: delimiters like Ruby #{ }, contents as code", "scope": ["meta.template.expression"], "settings": { "foreground": "#E3E1ED" } },
    { "scope": ["punctuation.definition.template-expression"], "settings": { "foreground": "#BD93F9" } },
    { "name": "JS/TS declared keys (object keys, type members, class fields) read like Ruby hash keys", "scope": ["meta.object-literal.key", "variable.object.property"], "settings": { "foreground": "#A6B4EE" } },
    { "name": "Built-in properties (length, prototype) are properties", "scope": ["support.variable"], "settings": { "foreground": "#74C4FF" } },
    { "name": "Decorators are declarations, like Rails DSL lines", "scope": ["punctuation.decorator"], "settings": { "foreground": "#DC92B7" } },
    { "scope": ["meta.type.signature.rbs", "meta.type.signature.rbs comment", "meta.type.signature.rbs punctuation.definition.comment", "meta.type.signature.rbs string", "meta.type.signature.rbs punctuation.definition.string", "meta.type.signature.rbs keyword", "meta.type.signature.rbs storage", "meta.type.signature.rbs variable.language", "meta.type.signature.rbs constant.language", "meta.type.signature.rbs keyword.operator", "meta.type.signature.rbs keyword.control.start-block.ruby", "meta.type.signature.rbs keyword.control.end.ruby", "meta.type.signature.rbs support.function.rails.dsl.ruby", "meta.type.signature.rbs keyword.other.special-method", "meta.type.signature.rbs entity.name.type", "meta.type.signature.rbs entity.name.class", "meta.type.signature.rbs entity.name.namespace", "meta.type.signature.rbs entity.other.inherited-class", "meta.type.signature.rbs support.class", "meta.type.signature.rbs support.type", "meta.type.signature.rbs variable.other.constant", "meta.type.signature.rbs variable.other.enummember", "meta.type.signature.rbs constant.other", "meta.type.signature.rbs constant.language.symbol", "meta.type.signature.rbs constant.other.symbol", "meta.type.signature.rbs constant.numeric", "meta.type.signature.rbs entity.name.function", "meta.type.signature.rbs support.function", "meta.type.signature.rbs keyword.other.special-method.ruby", "meta.type.signature.rbs variable", "meta.type.signature.rbs variable.parameter", "meta.type.signature.rbs punctuation.section.array", "meta.type.signature.rbs punctuation", "meta.type.signature.rbs meta", "meta.type.signature.rbs source"], "settings": { "foreground": "#8DBB7A" } },
    { "name": "Doc tags (JSDoc/YARD) inside comments stay comment-coloured", "scope": ["comment storage", "comment storage.type", "comment keyword", "comment keyword.operator", "comment variable", "comment variable.other", "comment entity", "comment entity.name.type", "comment entity.name.function", "comment support", "comment support.type", "comment support.class", "comment constant", "comment constant.language", "comment constant.numeric", "comment punctuation", "comment punctuation.definition", "comment markup", "comment string"], "settings": { "foreground": "#8DBB7A" } }
  ],
  "semanticTokenColors": {
    "class": "#62E1C7",
    "type": "#62E1C7",
    "namespace": "#62E1C7",
    "interface": "#62E1C7",
    "enum": "#62E1C7",
    "enumMember": "#74C4FF",
    "variable.readonly": "#74C4FF",
    "function": "#F1E4A6",
    "method": "#F1E4A6",
    "variable": "#74C4FF",
    "parameter": "#74C4FF",
    "string": "#FFAE92",
    "number": "#F0A04B",
    "typeParameter": "#62E1C7",
    "property": "#74C4FF",
    "property.declaration": "#A6B4EE"
  }
}
